# Cargo build directories: ignore intermediate files, but traverse directories
# so the explicitly listed deliverables below can be committed.
**/target/**
!**/target/**/

# CLI / daemon / MCP / legacy native host, including cross-target and debug builds.
!/target/release/ariaflow
!/target/release/ariaflow.exe
!/target/release/ariaflowd
!/target/release/ariaflowd.exe
!/target/release/ariaflow-mcp
!/target/release/ariaflow-mcp.exe
!/target/release/ariaflow-native-host
!/target/release/ariaflow-native-host.exe
!/target/debug/ariaflow
!/target/debug/ariaflow.exe
!/target/debug/ariaflowd
!/target/debug/ariaflowd.exe
!/target/debug/ariaflow-mcp
!/target/debug/ariaflow-mcp.exe
!/target/debug/ariaflow-native-host
!/target/debug/ariaflow-native-host.exe
!/target/*/release/ariaflow
!/target/*/release/ariaflow.exe
!/target/*/release/ariaflowd
!/target/*/release/ariaflowd.exe
!/target/*/release/ariaflow-mcp
!/target/*/release/ariaflow-mcp.exe
!/target/*/release/ariaflow-native-host
!/target/*/release/ariaflow-native-host.exe
!/target/*/debug/ariaflow
!/target/*/debug/ariaflow.exe
!/target/*/debug/ariaflowd
!/target/*/debug/ariaflowd.exe
!/target/*/debug/ariaflow-mcp
!/target/*/debug/ariaflow-mcp.exe
!/target/*/debug/ariaflow-native-host
!/target/*/debug/ariaflow-native-host.exe

# Tauri executables and distribution packages (host and cross-target builds).
!/apps/desktop/src-tauri/target/release/ariaflow-desktop
!/apps/desktop/src-tauri/target/release/ariaflow-desktop.exe
!/apps/desktop/src-tauri/target/debug/ariaflow-desktop
!/apps/desktop/src-tauri/target/debug/ariaflow-desktop.exe
!/apps/desktop/src-tauri/target/*/release/ariaflow-desktop
!/apps/desktop/src-tauri/target/*/release/ariaflow-desktop.exe
!/apps/desktop/src-tauri/target/*/debug/ariaflow-desktop
!/apps/desktop/src-tauri/target/*/debug/ariaflow-desktop.exe
!/apps/desktop/src-tauri/target/**/bundle/**/*.AppImage
!/apps/desktop/src-tauri/target/**/bundle/**/*.deb
!/apps/desktop/src-tauri/target/**/bundle/**/*.rpm
!/apps/desktop/src-tauri/target/**/bundle/**/*.msi
!/apps/desktop/src-tauri/target/**/bundle/**/*.exe
!/apps/desktop/src-tauri/target/**/bundle/**/*.dmg
!/apps/desktop/src-tauri/target/**/bundle/**/*.pkg
!/apps/desktop/src-tauri/target/**/bundle/**/*.zip
!/apps/desktop/src-tauri/target/**/bundle/**/*.tar.gz
!/apps/desktop/src-tauri/target/**/bundle/**/*.sig
!/apps/desktop/src-tauri/target/**/bundle/**/*.app/**

node_modules
dist
.output
*.log
ariaflow.db
ariaflow.db-wal
ariaflow.db-shm
*.part
*.tmp
.DS_Store
apps/desktop/src-tauri/gen
